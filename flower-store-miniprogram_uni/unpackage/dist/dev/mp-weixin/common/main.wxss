/* 梭哈酒馆 · 黑红质感主题（对标竞品颗粒纹理） */
.font-art {
    font-family: 'DouyinSans', 'PingFang SC', 'Helvetica Neue', sans-serif;
    font-weight: 700;
}

/* ---- 色彩令牌（非纯黑白）---- */

/* 墨黑 #121010  炭灰 #1c1a1a  岩白 #e6e2dc  酒红 #9a2a3c */
.poker-bg {
    position: relative;
    background-color: #100e0e;
    background-image:
        radial-gradient(ellipse 90% 55% at 50% -5%, rgba(154, 42, 60, 0.1), transparent 55%),
        radial-gradient(ellipse 45% 35% at 0% 40%, rgba(154, 42, 60, 0.05), transparent 50%),
        radial-gradient(ellipse 40% 30% at 100% 60%, rgba(40, 38, 38, 0.6), transparent 50%),
        linear-gradient(178deg, #141212 0%, #100e0e 42%, #0c0a0a 100%);
}

/* 颗粒噪点层 1：细点 */
.poker-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.55;
    background-image:
        radial-gradient(circle, rgba(255, 255, 255, 0.045) 0.6rpx, transparent 0.7rpx),
        radial-gradient(circle, rgba(0, 0, 0, 0.15) 0.5rpx, transparent 0.6rpx);
    background-size: 6rpx 6rpx, 9rpx 9rpx;
    background-position: 0 0, 3rpx 4rpx;
}

/* 颗粒噪点层 2：做旧划痕 */
.poker-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.07;
    background-image:
        repeating-linear-gradient(
            118deg,
            transparent,
            transparent 40rpx,
            rgba(255, 255, 255, 0.025) 40rpx,
            rgba(255, 255, 255, 0.025) 41rpx
        ),
        repeating-linear-gradient(
            -62deg,
            transparent,
            transparent 55rpx,
            rgba(154, 42, 60, 0.02) 55rpx,
            rgba(154, 42, 60, 0.02) 56rpx
        );
}

/* 卡片质感底 */
.mesh-card {
    position: relative;
    border-radius: 20rpx;
    border: 1rpx solid rgba(230, 226, 220, 0.07);
    background:
        linear-gradient(148deg, rgba(154, 42, 60, 0.07) 0%, transparent 38%),
        linear-gradient(165deg, #1e1c1c 0%, #161414 55%, #121010 100%);
    box-shadow:
        0 14rpx 36rpx rgba(0, 0, 0, 0.42),
        inset 0 1rpx 0 rgba(230, 226, 220, 0.06);
    overflow: hidden;
}
.mesh-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0.35;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.04) 0.5rpx, transparent 0.6rpx);
    background-size: 5rpx 5rpx;
}
.mesh-card-red {
    border-color: rgba(154, 42, 60, 0.22);
    background:
        linear-gradient(135deg, rgba(154, 42, 60, 0.14) 0%, transparent 45%),
        linear-gradient(165deg, #221618 0%, #141012 100%);
}

/* 竞品风浅色拼接块（会员条） */
.mesh-card-light {
    position: relative;
    border-radius: 20rpx;
    border: 1rpx solid rgba(0, 0, 0, 0.08);
    background:
        linear-gradient(160deg, #d8d4ce 0%, #c4c0ba 45%, #b8b4ae 100%);
    box-shadow:
        0 10rpx 28rpx rgba(0, 0, 0, 0.35),
        inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
    overflow: hidden;
}
.mesh-card-light::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image:
        radial-gradient(circle, rgba(0, 0, 0, 0.06) 0.5rpx, transparent 0.6rpx),
        radial-gradient(circle, rgba(255, 255, 255, 0.2) 0.4rpx, transparent 0.5rpx);
    background-size: 4rpx 4rpx, 7rpx 7rpx;
    background-position: 0 0, 2rpx 3rpx;
}
.mesh-card-light::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.06;
    background: repeating-linear-gradient(
        -25deg,
        transparent,
        transparent 30rpx,
        rgba(0, 0, 0, 0.04) 30rpx,
        rgba(0, 0, 0, 0.04) 31rpx
    );
}

/* 黑红拼接主按钮块 */
.tile-dark {
    background:
        linear-gradient(155deg, #222020 0%, #161414 60%, #100e0e 100%) !important;
    border: 1rpx solid rgba(230, 226, 220, 0.08) !important;
    box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04), 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}
.tile-red {
    background:
        linear-gradient(155deg, #2a181c 0%, #1a1014 55%, #120c0e 100%) !important;
    border: 1rpx solid rgba(154, 42, 60, 0.25) !important;
    box-shadow:
        inset 0 1rpx 0 rgba(154, 42, 60, 0.15),
        0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

/* 币商城 · 金色撞色块 */
.tile-gold {
    background:
        linear-gradient(155deg, #2a2418 0%, #1c1810 55%, #12100c 100%) !important;
    border: 1rpx solid rgba(232, 197, 71, 0.28) !important;
    box-shadow:
        inset 0 1rpx 0 rgba(247, 220, 138, 0.1),
        0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

/* ---- 撞色：深色底 + 边缘外发光（对标左图）---- */
.clash-glow-red {
    border: 1rpx solid rgba(255, 77, 141, 0.22) !important;
    border-left-color: rgba(255, 77, 141, 0.55) !important;
    border-top-color: rgba(255, 77, 141, 0.45) !important;
    box-shadow:
        -6rpx 0 22rpx rgba(255, 45, 106, 0.42),
        0 -4rpx 18rpx rgba(255, 45, 106, 0.28),
        0 0 0 1rpx rgba(255, 77, 141, 0.12),
        0 10rpx 28rpx rgba(0, 0, 0, 0.42) !important;
    background: linear-gradient(155deg, #1e1c1c 0%, #161414 58%, #121010 100%) !important;
}
.clash-glow-gold {
    border: 1rpx solid rgba(232, 197, 71, 0.22) !important;
    border-right-color: rgba(247, 220, 138, 0.55) !important;
    border-top-color: rgba(247, 220, 138, 0.48) !important;
    box-shadow:
        6rpx 0 24rpx rgba(232, 197, 71, 0.4),
        0 -4rpx 20rpx rgba(232, 197, 71, 0.3),
        0 0 0 1rpx rgba(232, 197, 71, 0.1),
        0 10rpx 28rpx rgba(0, 0, 0, 0.42) !important;
    background:
        radial-gradient(ellipse 38% 28% at 100% 0%, rgba(232, 197, 71, 0.1), transparent 72%),
        linear-gradient(155deg, #1e1a14 0%, #161410 58%, #12100c 100%) !important;
}
.clash-strip {
    background:
        linear-gradient(140deg, rgba(255, 45, 106, 0.09) 0%, rgba(232, 197, 71, 0.04) 45%, transparent 62%),
        linear-gradient(165deg, #221f1f 0%, #1a1818 55%, #151313 100%) !important;
    border: 1rpx solid rgba(255, 255, 255, 0.07) !important;
    box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.35) !important;
}
.icon-clash-pink {
    box-shadow:
        0 0 8rpx rgba(255, 45, 106, 0.28),
        inset 0 0 6rpx rgba(255, 45, 106, 0.05) !important;
    border-color: rgba(255, 77, 141, 0.28) !important;
}
.util-clash-pink {
    background: linear-gradient(165deg, #1e1c1c 0%, #161414 55%, #121010 100%) !important;
    border: 1rpx solid rgba(255, 255, 255, 0.07) !important;
    box-shadow:
        0 6rpx 22rpx rgba(255, 45, 106, 0.32),
        0 2rpx 10rpx rgba(255, 45, 106, 0.18),
        0 14rpx 36rpx rgba(0, 0, 0, 0.42) !important;
}
.util-clash-cyan {
    background: linear-gradient(165deg, #1a1c22 0%, #141418 55%, #101012 100%) !important;
    border: 1rpx solid rgba(77, 232, 255, 0.14) !important;
    box-shadow:
        0 6rpx 22rpx rgba(77, 232, 255, 0.28),
        0 2rpx 10rpx rgba(77, 232, 255, 0.14),
        0 14rpx 36rpx rgba(0, 0, 0, 0.42) !important;
}
.util-clash-gold {
    background: linear-gradient(165deg, #1e1c1c 0%, #161414 55%, #121010 100%) !important;
    border: 1rpx solid rgba(232, 197, 71, 0.12) !important;
    box-shadow:
        0 6rpx 22rpx rgba(232, 197, 71, 0.3),
        0 2rpx 10rpx rgba(232, 197, 71, 0.16),
        0 14rpx 36rpx rgba(0, 0, 0, 0.42) !important;
}
.hours-clash {
    border: 1rpx solid rgba(77, 232, 255, 0.42) !important;
    background: rgba(77, 232, 255, 0.06) !important;
    box-shadow: 0 0 20rpx rgba(77, 232, 255, 0.12);
}
.hours-clash .hours-value { color: #4de8ff !important;
}
.neon-pink { color: #ff6b9d;
}
.neon-red { color: #ff4d6d;
}
.neon-gold { color: #f0d878;
}
.neon-cyan { color: #4de8ff;
}
.tile-dark::before,
.tile-red::before,
.tile-gold::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.035) 0.5rpx, transparent 0.6rpx);
    background-size: 5rpx 5rpx;
}
.text-ink { color: #2a2624;
}
.text-ink-muted { color: #5c5652;
}
.text-chalk { color: #e6e2dc;
}
.text-chalk-muted { color: #a8a4a0;
}
.btn-neon {
    background: linear-gradient(135deg, #ff2d6a 0%, #ff007f 48%, #d42050 100%);
    color: #fff;
    font-weight: 700;
    box-shadow:
        0 0 18rpx rgba(255, 0, 127, 0.75),
        0 0 44rpx rgba(255, 45, 106, 0.5),
        0 6rpx 18rpx rgba(0, 0, 0, 0.3);
    border: 1rpx solid rgba(255, 120, 160, 0.4);
}
.btn-gold {
    background: linear-gradient(135deg, #ffe566 0%, #f7dc8a 35%, #e8c547 70%, #c99a3a 100%);
    color: #1a1410;
    font-weight: 800;
    box-shadow:
        0 0 20rpx rgba(255, 215, 0, 0.55),
        0 0 44rpx rgba(232, 197, 71, 0.32),
        0 6rpx 16rpx rgba(0, 0, 0, 0.28);
    border: 1rpx solid rgba(255, 240, 210, 0.25);
}
.btn-ghost-red {
    background: rgba(154, 42, 60, 0.08);
    border: 1rpx solid rgba(154, 42, 60, 0.35);
    color: #c0707c;
}

/* 充值条：左侧红拼接 + 粉色渐进光晕 */
.splash-red-bar {
    position: relative;
    overflow: hidden;
}
.splash-red-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(ellipse 30% 80% at 0% 50%, rgba(255, 45, 106, 0.06), transparent 70%);
}
.splash-red-bar::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6rpx;
    background: linear-gradient(180deg, #c04055, #9a2a3c, #6e1a28);
    border-radius: 20rpx 0 0 20rpx;
}
.deco-wine {
    position: absolute;
    width: 60rpx;
    height: 80rpx;
    opacity: 0.22;
    pointer-events: none;
}
.deco-wine::before {
    content: '';
    position: absolute;
    width: 3rpx;
    height: 28rpx;
    background: #c8c4be;
    top: 0;
    left: 50%;
    -webkit-transform: translateX(-50%) rotate(15deg);
            transform: translateX(-50%) rotate(15deg);
    -webkit-transform-origin: bottom center;
            transform-origin: bottom center;
}
.deco-wine::after {
    content: '';
    position: absolute;
    bottom: 8rpx;
    left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 18rpx solid transparent;
    border-right: 18rpx solid transparent;
    border-top: 36rpx solid rgba(154, 42, 60, 0.55);
}
.deco-cards {
    position: absolute;
    width: 80rpx;
    height: 100rpx;
    pointer-events: none;
    opacity: 0.18;
}
.deco-cards::before,
.deco-cards::after {
    content: '';
    position: absolute;
    width: 44rpx;
    height: 60rpx;
    border: 2rpx solid #d0ccc6;
    border-radius: 6rpx;
    background: rgba(22, 20, 20, 0.85);
}
.deco-cards::before { left: 0; top: 10rpx; -webkit-transform: rotate(-14deg); transform: rotate(-14deg);
}
.deco-cards::after { right: 0; top: 4rpx; -webkit-transform: rotate(12deg); transform: rotate(12deg); border-color: #9a2a3c;
}
.icon-box {
    width: 88rpx;
    height: 88rpx;
    border-radius: 16rpx;
    background: linear-gradient(160deg, #2a2828, #1a1818);
    border: 1rpx solid rgba(230, 226, 220, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}
.line-icon { width: 44rpx; height: 44rpx; position: relative;
}
.icon-user::before {
    content: '';
    position: absolute;
    width: 18rpx; height: 18rpx;
    border: 3rpx solid #c8c4be;
    border-radius: 50%;
    top: 2rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    box-sizing: border-box;
}
.icon-user::after {
    content: '';
    position: absolute;
    width: 30rpx; height: 16rpx;
    border: 3rpx solid #c8c4be;
    border-bottom: none;
    border-radius: 16rpx 16rpx 0 0;
    bottom: 2rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    box-sizing: border-box;
}
.icon-order::before {
    content: '';
    position: absolute;
    width: 28rpx; height: 34rpx;
    border: 3rpx solid #c8c4be;
    border-radius: 4rpx;
    top: 4rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    box-sizing: border-box;
}
.icon-order::after {
    content: '';
    position: absolute;
    width: 16rpx; height: 3rpx;
    background: #c8c4be;
    top: 16rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    box-shadow: 0 8rpx 0 #c8c4be;
}
.icon-coin::before {
    content: '';
    position: absolute;
    width: 22rpx; height: 30rpx;
    border: 3rpx solid #c8c4be;
    border-radius: 4rpx;
    top: 8rpx; left: 6rpx;
    -webkit-transform: rotate(-12deg);
            transform: rotate(-12deg);
    box-sizing: border-box;
}
.icon-coin::after {
    content: '';
    position: absolute;
    width: 22rpx; height: 30rpx;
    border: 3rpx solid #9a2a3c;
    border-radius: 4rpx;
    top: 6rpx; right: 6rpx;
    -webkit-transform: rotate(10deg);
            transform: rotate(10deg);
    box-sizing: border-box;
}
.icon-recharge::before {
    content: '';
    position: absolute;
    width: 32rpx; height: 24rpx;
    border: 3rpx solid #c8c4be;
    border-radius: 6rpx;
    top: 10rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    box-sizing: border-box;
}
.icon-recharge::after {
    content: '';
    position: absolute;
    width: 20rpx; height: 3rpx;
    background: #c8c4be;
    top: 18rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
}
.icon-rank::before {
    content: '';
    position: absolute;
    width: 8rpx; height: 14rpx;
    background: #c8c4be;
    bottom: 6rpx; left: 8rpx;
    border-radius: 2rpx 2rpx 0 0;
    box-shadow: 14rpx -8rpx 0 #c8c4be, 28rpx -14rpx 0 #9a2a3c;
}
.icon-qrcode {
    width: 36rpx; height: 36rpx;
    position: relative;
    border: 3rpx solid #6a6662;
    border-radius: 4rpx;
    box-sizing: border-box;
}
.icon-qrcode::before {
    content: '';
    position: absolute;
    width: 10rpx; height: 10rpx;
    top: 4rpx; left: 4rpx;
    background: #6a6662;
    box-shadow: 14rpx 0 0 #6a6662, 0 14rpx 0 #6a6662, 14rpx 14rpx 0 #6a6662;
}
.mesh-card-light .icon-qrcode {
    border-color: #4a4644;
}
.mesh-card-light .icon-qrcode::before {
    background: #4a4644;
    box-shadow: 14rpx 0 0 #4a4644, 0 14rpx 0 #4a4644, 14rpx 14rpx 0 #4a4644;
}
.icon-cocktail::before {
    content: '';
    position: absolute;
    width: 3rpx; height: 14rpx;
    background: #d0ccc6;
    top: 2rpx; left: 50%;
    -webkit-transform: translateX(-50%) rotate(20deg);
            transform: translateX(-50%) rotate(20deg);
    -webkit-transform-origin: bottom center;
            transform-origin: bottom center;
}
.icon-cocktail::after {
    content: '';
    position: absolute;
    width: 0; height: 0;
    border-left: 14rpx solid transparent;
    border-right: 14rpx solid transparent;
    border-top: 22rpx solid #d0ccc6;
    bottom: 4rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
}
.icon-wifi::before {
    content: '';
    position: absolute;
    width: 28rpx; height: 14rpx;
    border: 3rpx solid #c8c4be;
    border-bottom: none;
    border-radius: 28rpx 28rpx 0 0;
    bottom: 14rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    box-sizing: border-box;
}
.icon-wifi::after {
    content: '';
    position: absolute;
    width: 6rpx; height: 6rpx;
    background: #c8c4be;
    border-radius: 50%;
    bottom: 8rpx; left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
}
.disclaimer-text {
    display: block;
    text-align: center;
    font-size: 22rpx;
    color: #6a6662;
    line-height: 1.7;
    padding: 16rpx 40rpx 8rpx;
    letter-spacing: 1rpx;
}

/**app.wxss - 梭哈酒馆 设计系统**/
page {
    /* 品牌金 */
    --gold: #e8c547;
    --gold-light: #f7dc8a;
    --gold-dark: #c99a3a;
    --gold-gradient: linear-gradient(135deg, #f7dc8a 0%, #d4a72c 100%);

    /* 黑红主色调（暖调，非纯黑白） */
    --ink-black: #121010;
    --charcoal: #1c1a1a;
    --stone-light: #d8d4ce;
    --stone-mid: #b8b4ae;
    --chalk: #e6e2dc;
    --wine-red: #9a2a3c;
    --wine-deep: #6e1a28;
    --neon-pink: #b84a5c;
    --neon-pink-light: #c0707c;
    --neon-red: #9a2a3c;
    --neon-cyan: #a8a4a0;
    --poker-red: #9a2a3c;
    --accent-magenta: #8a2434;

    /* 背景层级 */
    --bg-page: #100e0e;
    --bg-card: #1e1c1c;
    --bg-card-gradient: linear-gradient(155deg, #222020, #161414);
    --bg-elevated: #2a2828;
    --bg-sunken: #141212;

    /* 文字层级 */
    --text-primary: #e6e2dc;
    --text-regular: #c8c4be;
    --text-muted: #8a8682;
    --text-faint: #6a6662;
    --text-secondary: #8a8a8e;

    /* 描边 */
    --border-subtle: rgba(255, 255, 255, 0.07);
    --border-gold: rgba(232, 197, 71, 0.15);

    /* 语义色 */
    --danger: #e5484d;
    --success: #30a46c;

    /* 兼容旧变量名 */
    --primary-color: #e8c547;
    --secondary-color: #c41e3a;
    --text-color: #f5f5f5;
    --price-color: #e8c547;
    --light-gray: #1a1a1a;
    --border-color: #333333;
    --disabled-color: #6b6b70;
    --bg-dark: #0b0b0c;
    --accent-gold: #e8c547;

    font-family: 'DouyinSans', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-primary);
    background-color: var(--bg-page);
    box-sizing: border-box;
}

/* 常用颜色类 */
.text-primary {
    color: var(--gold);
}
.text-secondary {
    color: var(--text-muted);
}
.bg-primary {
    background: var(--gold-gradient);
}
.bg-secondary {
    background-color: var(--secondary-color);
}

/* 页面容器 */
.page-dark {
    min-height: 100vh;
    background-color: var(--bg-page);
    box-sizing: border-box;
}

/* 区块标题：左侧金色竖条 */
.section-head {
    position: relative;
    padding: 4rpx 0 24rpx 22rpx;
    color: var(--text-primary);
    font-size: 30rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}
.section-head::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7rpx;
    width: 6rpx;
    height: 30rpx;
    border-radius: 4rpx;
    background: linear-gradient(180deg, var(--gold-light), var(--gold-dark));
}

/* 金色图标徽章：统一替代彩色 emoji */
.g-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 76rpx;
    height: 76rpx;
    border-radius: 50%;
    border: 1rpx solid rgba(232, 197, 71, 0.34);
    background: radial-gradient(circle at 32% 26%, rgba(232, 197, 71, 0.2), rgba(232, 197, 71, 0.05));
    color: var(--gold-light);
    font-size: 28rpx;
    font-weight: 700;
    line-height: 1;
}
.g-icon-lg {
    width: 96rpx;
    height: 96rpx;
    font-size: 36rpx;
}
.g-icon-sm {
    width: 56rpx;
    height: 56rpx;
    font-size: 26rpx;
}

/* 购物袋图标（CSS 绘制，避免 emoji） */
.g-bag {
    position: relative;
    width: 34rpx;
    height: 30rpx;
    box-sizing: border-box;
    border: 3rpx solid currentColor;
    border-radius: 5rpx 5rpx 8rpx 8rpx;
}
.g-bag::before {
    content: '';
    position: absolute;
    top: -13rpx;
    left: 50%;
    -webkit-transform: translateX(-50%);
            transform: translateX(-50%);
    width: 18rpx;
    height: 14rpx;
    box-sizing: border-box;
    border: 3rpx solid currentColor;
    border-bottom: none;
    border-radius: 9rpx 9rpx 0 0;
}

/* 点按反馈 */
.g-tap {
    transition: opacity 0.16s ease, -webkit-transform 0.16s ease;
    transition: transform 0.16s ease, opacity 0.16s ease;
    transition: transform 0.16s ease, opacity 0.16s ease, -webkit-transform 0.16s ease;
}
.g-tap:active {
    -webkit-transform: scale(0.97);
            transform: scale(0.97);
    opacity: 0.82;
}

/* 数字统一等宽，价格不跳动 */
.g-num {
    font-variant-numeric: tabular-nums;
    -webkit-font-feature-settings: 'tnum';
            font-feature-settings: 'tnum';
    letter-spacing: 0;
}

/* 空状态 */
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 140rpx 40rpx;
}
.empty-state-icon {
    font-size: 28rpx;
    font-weight: 700;
    letter-spacing: 8rpx;
    color: var(--gold);
    opacity: 0.55;
    margin-bottom: 20rpx;
    padding: 18rpx 28rpx;
    border: 1rpx solid rgba(232, 197, 71, 0.28);
    border-radius: 12rpx;
}
.empty-state-text {
    color: var(--text-muted);
    font-size: 28rpx;
}
.empty-state-tip {
    margin-top: 12rpx;
    color: var(--text-faint);
    font-size: 23rpx;
}

/* 常用布局类 */
.container {
    padding: 20rpx;
    box-sizing: border-box;
}
.flex {
    display: flex;
}
.flex-column {
    display: flex;
    flex-direction: column;
}
.flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.flex-center {
    display: flex;
    justify-content: center;
    align-items: center;
}
.flex-around {
    display: flex;
    justify-content: space-around;
    align-items: center;
}

/* 常用间距类 */
.mt-10 {
    margin-top: 10rpx;
}
.mt-20 {
    margin-top: 20rpx;
}
.mb-10 {
    margin-bottom: 10rpx;
}
.mb-20 {
    margin-bottom: 20rpx;
}

/* 常用文本类 */
.text-bold {
    font-weight: bold;
}
.text-center {
    text-align: center;
}
.text-right {
    text-align: right;
}
.text-ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.text-small {
    font-size: 12px;
}
.text-large {
    font-size: 16px;
}
.text-xl {
    font-size: 18px;
}

/* 价格样式 */
.price {
    color: var(--gold);
    font-weight: bold;
}
.price-original {
    color: var(--text-faint);
    text-decoration: line-through;
    font-size: 12px;
    margin-left: 10rpx;
}

/* 按钮样式 */
.btn {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20rpx 30rpx;
    border-radius: 40rpx;
    font-size: 14px;
    font-weight: 600;
    border: none;
}
.btn::after {
    border: none;
}
.btn-primary {
    background: var(--gold-gradient);
    color: #171717;
    box-shadow: 0 8rpx 24rpx rgba(232, 197, 71, 0.22);
}
.btn-secondary {
    background-color: var(--bg-elevated);
    color: var(--text-regular);
}
.btn-outline {
    background: transparent;
    color: var(--gold);
    border: 2rpx solid var(--gold);
}
.btn-disabled {
    background: var(--bg-elevated);
    color: var(--text-faint);
    box-shadow: none;
}
.btn-block {
    width: 100%;
}

/* 卡片样式 */
.card {
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 28rpx;
    overflow: hidden;
    border: 1rpx solid var(--border-gold);
    border-radius: 22rpx;
    background: var(--bg-card-gradient);
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.24);
}
.card-header {
    padding-bottom: 22rpx;
    border-bottom: 1rpx solid var(--border-subtle);
    color: var(--text-primary);
    font-weight: 600;
}
.card-body {
    padding-top: 22rpx;
}
.card-footer {
    margin-top: 22rpx;
    padding-top: 22rpx;
    border-top: 1rpx solid var(--border-subtle);
}

/* 分割线 */
.divider {
    height: 1rpx;
    background-color: var(--border-subtle);
    margin: 20rpx 0;
}

/* 标签样式 */
.tag {
    display: inline-block;
    padding: 6rpx 16rpx;
    border-radius: 8rpx;
    font-size: 12px;
    margin-right: 10rpx;
}
.tag-primary {
    background-color: rgba(232, 197, 71, 0.12);
    border: 1rpx solid rgba(232, 197, 71, 0.35);
    color: var(--gold-light);
}
.tag-secondary {
    background-color: rgba(196, 30, 58, 0.12);
    border: 1rpx solid rgba(196, 30, 58, 0.35);
    color: #f08c9b;
}

/* 网格布局 */
.grid {
    display: flex;
    flex-wrap: wrap;
}
.grid-item {
    box-sizing: border-box;
}
.grid-2 .grid-item {
    width: 50%;
}
.grid-3 .grid-item {
    width: 33.33%;
}
.grid-4 .grid-item {
    width: 25%;
}

