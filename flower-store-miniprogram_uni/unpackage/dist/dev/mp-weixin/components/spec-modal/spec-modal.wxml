<block wx:if="{{visible}}"><view data-event-opts="{{[['tap',[['onClose',['$event']]]]]}}" class="spec-mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="spec-modal" catchtap="__e"><view class="spec-header"><image class="spec-img" src="{{product.image||'/static/allIn.jpg'}}" mode="aspectFill"></image><view class="spec-title-wrap"><text class="spec-name">{{product.name}}</text></view><view data-event-opts="{{[['tap',[['onClose',['$event']]]]]}}" class="spec-close" bindtap="__e">⌄</view></view><scroll-view class="spec-body" scroll-y="{{true}}"><view class="spec-row"><text class="spec-label">数量</text><view class="qty-control"><view data-event-opts="{{[['tap',[['decrease',['$event']]]]]}}" class="qty-btn" bindtap="__e">−</view><text class="qty-num">{{count}}</text><view data-event-opts="{{[['tap',[['increase',['$event']]]]]}}" class="qty-btn" bindtap="__e">＋</view></view></view><block wx:for="{{specGroups}}" wx:for-item="group" wx:for-index="gIndex" wx:key="gIndex"><view class="spec-group"><text class="spec-label">{{group.name}}</text><view class="spec-options"><block wx:for="{{group.options}}" wx:for-item="opt" wx:for-index="oIndex" wx:key="oIndex"><view data-event-opts="{{[['tap',[['selectOption',[gIndex,oIndex]]]]]}}" class="{{['spec-option '+(selected[gIndex]===oIndex?'active':'')]}}" bindtap="__e">{{opt.label}}</view></block></view></view></block></scroll-view><view class="spec-footer"><view class="spec-price-wrap"><text class="spec-price">{{"¥ "+totalPrice}}</text><text class="spec-selected">{{selectedText}}</text></view><view data-event-opts="{{[['tap',[['onConfirm',['$event']]]]]}}" class="spec-confirm g-tap" bindtap="__e"><text>加入购物车</text></view></view></view></view></block>