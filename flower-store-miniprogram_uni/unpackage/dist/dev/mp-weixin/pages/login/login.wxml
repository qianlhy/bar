<view class="login-container"><view class="login-header"><view class="logo-area"><view class="logo-ring"><image class="logo-img" src="/static/allIn.jpg" mode="aspectFill"></image></view></view><text class="title">欢迎来到 梭哈酒馆</text></view><block wx:if="{{showProfile}}"><view class="profile-setup"><view class="profile-kicker">MEMBER PROFILE</view><text class="profile-title">完善个人资料</text><text class="profile-tip">使用微信头像与昵称，开启你的酒馆会员身份</text><button class="avatar-picker" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><view class="avatar-ring"><view class="avatar-glow"></view><image class="avatar-preview" src="{{profileAvatar||'/static/allIn.jpg'}}" mode="aspectFill"></image><view class="avatar-camera"><text class="camera-dot"></text><text class="camera-text">{{avatarUploading?'上传中':'换头像'}}</text></view></view><text class="avatar-hint">{{avatarUploading?'头像上传中，请稍候...':'点击上方选择微信头像'}}</text></button><view class="profile-item"><text class="profile-label">昵称</text><input class="profile-input" type="nickname" placeholder="点击获取微信昵称" data-event-opts="{{[['input',[['onNicknameInput',['$event']]]],['change',[['onNicknameInput',['$event']]]]]}}" value="{{profileNickname}}" bindinput="__e" bindchange="__e"/></view><button class="login-btn" disabled="{{avatarUploading}}" data-event-opts="{{[['tap',[['saveProfile',['$event']]]]]}}" bindtap="__e">完成</button><view data-event-opts="{{[['tap',[['skipProfile',['$event']]]]]}}" class="profile-skip" bindtap="__e">跳过，稍后再说</view></view></block><block wx:if="{{!showProfile}}"><view class="login-form"><button class="{{['wx-login-btn primary '+(isLoading?'loading':'')]}}" disabled="{{isLoading}}" data-event-opts="{{[['tap',[['wxLogin',['$event']]]]]}}" bindtap="__e"><image class="wx-icon" src="/static/images/icons/wechat.png" mode="aspectFit"></image>{{''+(isLoading?'登录中...':'微信一键登录')+''}}</button><view class="agreement"><view data-event-opts="{{[['tap',[['toggleAgree',['$event']]]]]}}" class="{{['checkbox '+(isAgree?'checked':'')]}}" bindtap="__e"></view><text class="agreement-text">我已阅读并同意</text><text data-event-opts="{{[['tap',[['goToUserAgreement',['$event']]]]]}}" class="agreement-link" bindtap="__e">《用户协议》</text><text class="agreement-text">和</text><text data-event-opts="{{[['tap',[['goToPrivacyPolicy',['$event']]]]]}}" class="agreement-link" bindtap="__e">《隐私政策》</text></view><view data-event-opts="{{[['tap',[['togglePhoneLogin',['$event']]]]]}}" class="phone-login-entry" bindtap="__e">{{''+(usePhoneLogin?'返回微信登录':'使用手机号登录')+''}}</view></view></block><block wx:if="{{!showProfile&&usePhoneLogin}}"><view class="login-form phone-form"><view class="form-item"><view class="input-label">手机号</view><input class="input" type="number" placeholder="请输入手机号" maxlength="11" data-event-opts="{{[['input',[['inputPhone',['$event']]]]]}}" value="{{phone}}" bindinput="__e"/></view><view class="form-item"><view class="input-label">{{isPasswordLogin?'密码':'验证码'}}</view><view class="input-wrapper"><input class="{{['input '+(!isPasswordLogin?'input-with-btn':'')]}}" type="{{isPasswordLogin?'password':'number'}}" placeholder="{{isPasswordLogin?'请输入密码':'请输入验证码'}}" maxlength="{{isPasswordLogin?'20':'6'}}" data-event-opts="{{[['input',[['inputPassword',['$event']]]]]}}" value="{{password}}" bindinput="__e"/><block wx:if="{{!isPasswordLogin}}"><view data-event-opts="{{[['tap',[['getVerifyCode',['$event']]]]]}}" class="{{['verify-code-btn '+(countdown>0?'disabled':'')]}}" catchtap="__e">{{''+(countdown>0?countdown+'s':'获取验证码')+''}}</view></block></view></view><view data-event-opts="{{[['tap',[['switchLoginType',['$event']]]]]}}" class="login-type-switch" bindtap="__e"><text>{{isPasswordLogin?'验证码登录':'密码登录'}}</text></view><button class="{{['login-btn '+(isLoading?'loading':'')]}}" disabled="{{isLoading}}" data-event-opts="{{[['tap',[['passwordLogin',['$event']]]]]}}" bindtap="__e">{{''+(isLoading?'登录中...':'登 录')+''}}</button></view></block></view>