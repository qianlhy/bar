<view class="cart-container"><block wx:if="{{!isLogin}}"><view class="login-tip"><text>登录后才能同步购物车哦</text><view data-event-opts="{{[['tap',[['goToLogin',['$event']]]]]}}" class="login-btn" bindtap="__e">去登录</view></view></block><block wx:if="{{isEmpty}}"><view class="empty-cart"><view class="empty-state"><text class="empty-state-icon">空</text><text class="empty-state-text">购物车还是空的</text><text class="empty-state-tip">去点一杯，开启今晚的局</text></view><button data-event-opts="{{[['tap',[['goToShopping',['$event']]]]]}}" class="go-shopping-btn g-tap" bindtap="__e">去点单</button></view></block><block wx:if="{{!isEmpty}}"><view class="cart-list"><block wx:for="{{cartList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="cart-item"><view class="select-box" data-index="{{index}}" data-event-opts="{{[['tap',[['toggleSelect',['$event']]]]]}}" bindtap="__e"><view class="{{['select-icon '+(item.selected?'selected':'')]}}"></view></view><image class="product-image" src="{{item.image||'/static/allIn.jpg'}}" mode="aspectFill" data-event-opts="{{[['error',[['onProductImageError',[index]]]]]}}" binderror="__e"></image><view class="product-info"><text class="product-name text-ellipsis">{{item.name}}</text><block wx:if="{{item.specText}}"><text class="product-spec">{{item.specText}}</text></block><view class="product-price-box"><text class="price g-num">{{"¥"+item.price}}</text></view><view class="product-action"><view class="counter"><view class="{{['counter-btn '+(item.count<=1?'disabled':'')]}}" data-id="{{item.id}}" data-count="{{item.count}}" data-event-opts="{{[['tap',[['decreaseCount',['$event']]]]]}}" bindtap="__e">-</view><view class="counter-num">{{item.count}}</view><view class="{{['counter-btn '+(item.count>=item.inventory?'disabled':'')]}}" data-id="{{item.id}}" data-count="{{item.count}}" data-inventory="{{item.inventory}}" data-event-opts="{{[['tap',[['increaseCount',['$event']]]]]}}" bindtap="__e"> + </view></view><view class="delete-btn" data-id="{{item.id}}" data-event-opts="{{[['tap',[['deleteItem',['$event']]]]]}}" bindtap="__e"><image class="delete-icon" src="/static/images/icons/delete.png"></image></view></view></view></view></block></view></block><block wx:if="{{!isEmpty}}"><view class="cart-footer"><view data-event-opts="{{[['tap',[['toggleSelectAll',['$event']]]]]}}" class="select-all" bindtap="__e"><view class="{{['select-icon '+(isAllSelected?'selected':'')]}}"></view><text>全选</text></view><view class="cart-total"><view class="total-price"><text class="price-label">合计：</text><text class="price g-num">{{"¥"+totalPrice}}</text></view><text class="price-desc">店内消费</text></view><button data-event-opts="{{[['tap',[['goToCheckout',['$event']]]]]}}" class="checkout-btn" bindtap="__e">{{"结算("+totalCount+")"}}</button></view></block></view>