<view class="order-page"><view class="store-bar"><view data-event-opts="{{[['tap',[['showStorePicker',['$event']]]]]}}" class="store-info" bindtap="__e"><text class="store-text">梭哈酒馆-南京店</text><text class="store-arrow">›</text></view><view class="store-tag">店内</view></view><view class="order-body"><view class="sidebar"><scroll-view class="sidebar-scroll" scroll-y="{{true}}"><block wx:for="{{categories}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['sidebar-item '+(currentCategory&&currentCategory.id===item.id?'active':'')]}}" data-id="{{item.id}}" data-event-opts="{{[['tap',[['switchCategory',['$event']]]]]}}" bindtap="__e"><block wx:if="{{currentCategory&&currentCategory.id===item.id}}"><image class="cat-icon" src="{{item.icon||'/static/images/cat-default.png'}}" mode="aspectFill"></image></block><text class="cat-name">{{item.name}}</text></view></block></scroll-view></view><view class="product-area"><scroll-view class="product-scroll" scroll-y="{{true}}"><block wx:if="{{currentCategory}}"><view class="section-title">{{currentCategory.name}}</view></block><block wx:if="{{$root.g0}}"><view class="no-data"><text>暂无商品</text></view></block><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="product-item" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['onTapProduct',['$event']]]]]}}" bindtap="__e"><image class="product-img" src="{{item.$orig.image||'/static/allIn.jpg'}}" mode="aspectFill" data-event-opts="{{[['error',[['onProductImageError',[index]]]]]}}" binderror="__e"></image><view class="product-detail"><text class="product-name">{{item.$orig.name}}</text><text class="product-desc">{{item.$orig.description}}</text><text class="product-sales">{{"销量"+item.$orig.sales}}</text><view class="price-row"><text class="product-price">{{"¥"+item.$orig.price}}</text><block wx:if="{{item.$orig.originalPrice}}"><text class="product-original">{{"¥"+item.$orig.originalPrice}}</text></block></view></view><block wx:if="{{item.m0}}"><view class="spec-btn" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['openSpecModal',['$event']]]]]}}" catchtap="__e">选规格</view></block><block wx:else><view class="add-btn g-tap" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['onAddToCart',['$event']]]]]}}" catchtap="__e">+</view></block></view></block></scroll-view></view></view><block wx:if="{{cartCount>0}}"><view data-event-opts="{{[['tap',[['goCart',['$event']]]]]}}" class="cart-bar" bindtap="__e"><view class="cart-icon-wrap"><view class="g-bag"></view><view class="cart-badge">{{cartCount}}</view></view><view class="cart-info"><text class="cart-total g-num">{{"¥"+cartTotal}}</text><text class="cart-tip">点击查看购物车</text></view><view data-event-opts="{{[['tap',[['goCart',['$event']]]]]}}" class="checkout-btn" catchtap="__e">去结算</view></view></block><spec-modal vue-id="9d275500-1" visible="{{showSpecModal}}" product="{{specProduct}}" data-event-opts="{{[['^close',[['e0']]],['^confirm',[['onSpecConfirm']]]]}}" data-com-type="wx" bind:close="__e" bind:confirm="__e" bind:__l="__l"></spec-modal><block wx:if="{{isLoading}}"><view class="loading-mask"><text class="loading-text">加载中...</text></view></block></view>