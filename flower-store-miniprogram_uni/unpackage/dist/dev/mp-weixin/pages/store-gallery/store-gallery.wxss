
.gallery-page {
    min-height: 100vh;
    padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
}
.gallery-swiper {
    width: 100%;
    height: calc(100vh - 160rpx);
    border-radius: 20rpx;
    overflow: hidden;
    border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.gallery-img {
    width: 100%;
    height: 100%;
    display: block;
}
.gallery-empty {
    margin-top: 200rpx;
    text-align: center;
}
.empty-title {
    font-size: 36rpx;
    color: #ddd;
    display: block;
}
.empty-tip {
    font-size: 26rpx;
    color: #666;
    margin-top: 20rpx;
    display: block;
}
.gallery-tip {
    text-align: center;
    margin-top: 24rpx;
}
.gallery-tip text {
    font-size: 22rpx;
    color: #555;
}

