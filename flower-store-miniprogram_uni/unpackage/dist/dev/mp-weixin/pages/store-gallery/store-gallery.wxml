<view class="gallery-page poker-bg"><block wx:if="{{$root.g0>0}}"><swiper class="gallery-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.3)" indicator-active-color="#a01c30" autoplay="{{true}}" interval="{{4000}}" circular="{{true}}"><block wx:for="{{images}}" wx:for-item="img" wx:for-index="index" wx:key="index"><swiper-item><image class="gallery-img" src="{{img}}" mode="aspectFill" data-index="{{index}}" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" bindtap="__e"></image></swiper-item></block></swiper></block><block wx:else><view class="gallery-empty"><text class="empty-title font-art">店内环境</text><text class="empty-tip">暂无装修展示图片，敬请期待</text></view></block><block wx:if="{{$root.g1>0}}"><view class="gallery-tip"><text>点击图片可全屏预览</text></view></block></view>