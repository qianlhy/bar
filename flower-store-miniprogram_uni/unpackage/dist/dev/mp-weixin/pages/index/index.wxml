<view class="home-page poker-bg"><view class="status-bar" style="{{('height:'+statusBarHeight+'px')}}"></view><text class="poker-float spade">♠</text><text class="poker-float heart">♥</text><text class="poker-float club">♣</text><text class="poker-float diamond">♦</text><scroll-view class="home-scroll" scroll-y="{{true}}"><view class="top-bar"><view data-event-opts="{{[['tap',[['showStorePicker',['$event']]]]]}}" class="top-greet g-tap font-art" bindtap="__e"><text class="top-greet-text">{{storeName}}</text></view><view class="top-icons"><view data-event-opts="{{[['tap',[['showMemberCode',['$event']]]]]}}" class="top-icon g-tap" bindtap="__e">码</view><view data-event-opts="{{[['tap',[['goSettings',['$event']]]]]}}" class="top-icon g-tap" bindtap="__e">设</view></view></view><view class="hero-brand"><view class="deco-wine hero-wine"></view><view class="deco-cards hero-cards"></view><view class="suoha-logo-stack"><text class="art-suoha font-art">梭哈</text><view class="logo-stage"><view class="logo-ring"><image class="brand-logo" src="/static/allIn.jpg" mode="aspectFill"></image></view><text class="card-deco left">♠A</text><text class="card-deco right">♥K</text></view></view><text class="brand-en font-display neon-gold">ALL IN TAVERN</text><view class="hours-pill hours-clash"><text class="hours-label">营业时间</text><text class="hours-value font-num">{{businessHours}}</text></view></view><view class="member-strip mesh-card clash-strip"><view data-event-opts="{{[['tap',[['showMemberCode',['$event']]]]]}}" class="strip-item g-tap" bindtap="__e"><view class="icon-box strip-icon-box icon-clash-pink"><view class="icon-qrcode"></view></view><text class="strip-label font-art neon-pink">会员码</text></view><view class="strip-divider"></view><view class="strip-item"><text class="strip-num font-num neon-gold">{{userInfo.points||0}}</text><text class="strip-label">我的积分</text></view><view class="strip-divider"></view><view class="strip-item"><text class="strip-num font-num neon-cyan">{{userInfo.coins||0}}</text><text class="strip-label">All In 币</text></view></view><view class="dual-hero"><view data-event-opts="{{[['tap',[['goOrder',['$event']]]]]}}" class="hero-btn order-btn g-tap clash-card" bindtap="__e"><view class="card-wash card-wash-pink-bl"></view><text class="hero-btn-cn font-art">立即点单</text><text class="hero-btn-en font-display">ORDER</text><view class="hero-deco"><view class="line-icon icon-cocktail"></view></view></view><view data-event-opts="{{[['tap',[['goCoinMall',['$event']]]]]}}" class="hero-btn mall-btn g-tap clash-card" bindtap="__e"><view class="card-wash card-wash-gold-tr"></view><text class="hero-btn-cn font-art neon-gold">币商城</text><text class="hero-btn-en font-display">POINT</text><view class="hero-deco"><view class="line-icon icon-coin"></view></view></view></view><view data-event-opts="{{[['tap',[['goRecharge',['$event']]]]]}}" class="recharge-banner splash-red-bar g-tap mesh-card" bindtap="__e"><view class="card-wash card-wash-pink-r"></view><text class="banner-watermark">MEMBER</text><view class="banner-body"><view class="banner-copy"><text class="banner-title font-art">会员充值</text><text class="banner-sub">享受更多专属优惠福利</text></view><view class="banner-btn btn-neon font-art">立即充值</view></view></view><view class="util-row"><view data-event-opts="{{[['tap',[['doCheckin',['$event']]]]]}}" class="{{['util-card g-tap clash-card '+(checkedIn?'done':'')]}}" bindtap="__e"><view class="card-wash card-wash-pink-b"></view><view class="util-icon-wrap"><text class="util-char util-star-pink">✦</text></view><text class="util-title font-art">{{checkedIn?'今日已签':'每日签到'}}</text><text class="util-sub">{{checkedIn?'积分 '+(userInfo.points||0):'+'+checkinReward+' 积分'}}</text></view><view data-event-opts="{{[['tap',[['showWifi',['$event']]]]]}}" class="util-card g-tap clash-card" bindtap="__e"><view class="card-wash card-wash-cyan-t"></view><view class="util-icon-wrap"><view class="line-icon icon-wifi"></view></view><text class="util-title font-art">查看 WiFi</text><text class="util-sub">店内专属网络</text></view><view data-event-opts="{{[['tap',[['showMemberCode',['$event']]]]]}}" class="util-card g-tap clash-card" bindtap="__e"><view class="card-wash card-wash-gold-t"></view><view class="util-icon-wrap"><text class="util-char util-star-gold">★</text></view><text class="util-title font-art">会员特权</text><text class="util-sub">出示会员码</text></view></view><view class="store-card mesh-card store-glow-cyan"><view class="store-card-head"><text class="store-card-title font-art">门店地址</text><view data-event-opts="{{[['tap',[['openNavigation',['$event']]]]]}}" class="store-nav-link g-tap" bindtap="__e"><text class="store-nav-text neon-cyan">导航</text><text class="store-nav-arrow">›</text></view></view><text class="store-card-address">{{storeAddress}}</text><text class="store-card-phone">{{"预定电话 "+storePhone}}</text><view class="store-card-actions"><view data-event-opts="{{[['tap',[['callStore',['$event']]]]]}}" class="store-primary-btn btn-gold g-tap" bindtap="__e"><text class="store-primary-text font-art">立即预定</text></view><view class="store-secondary-row"><view data-event-opts="{{[['tap',[['goStoreGallery',['$event']]]]]}}" class="store-secondary-item g-tap" bindtap="__e"><text class="sec-icon">◫</text><text class="sec-text font-art">店内环境</text></view><view class="store-secondary-divider"></view><view data-event-opts="{{[['tap',[['callStore',['$event']]]]]}}" class="store-secondary-item g-tap store-clash-cyan" bindtap="__e"><text class="sec-icon cyan">☎</text><text class="sec-text font-art">拨打电话</text></view></view></view></view><view class="footer"><text class="disclaimer-text">绿色竞技，禁止赌博！筹码仅做计分牌使用，无任何现金价值！</text><text class="footer-text">熠火提供技术支持</text></view></scroll-view><block wx:if="{{showPrivacy}}"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="privacy-mask" catchtap="__e"><view class="privacy-modal"><text class="privacy-title">用户隐私保护提示</text><scroll-view class="privacy-content" scroll-y="{{true}}"><text>{{"欢迎使用梭哈酒馆小程序。请在授权前阅读微信官方"+privacyContractName+"，了解头像、昵称以及订单和支付必要信息的处理方式。"}}</text><text class="privacy-p">您可以拒绝非必要授权并继续浏览商品；登录、下单或资料设置等功能只会在实际需要时申请对应信息。</text><text data-event-opts="{{[['tap',[['openPrivacyContract',['$event']]]]]}}" class="privacy-link" bindtap="__e">{{"查看微信官方"+privacyContractName}}</text></scroll-view><view class="privacy-btns"><view data-event-opts="{{[['tap',[['declinePrivacy',['$event']]]]]}}" class="privacy-btn decline" bindtap="__e">暂不授权</view><button class="privacy-btn agree" open-type="agreePrivacyAuthorization" data-event-opts="{{[['agreeprivacyauthorization',[['onAgreePrivacyAuthorization',['$event']]]]]}}" bindagreeprivacyauthorization="__e">同意并继续</button></view></view></view></block><block wx:if="{{showMemberModal}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="member-mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="member-modal" catchtap="__e"><text class="member-modal-title">会员码</text><block wx:if="{{memberCodeUrl}}"><image class="qrcode-img" src="{{memberCodeUrl}}" mode="aspectFit"></image></block><block wx:else><view class="qrcode-placeholder"><text class="qrcode-text">请先登录</text></view></block><text class="member-modal-tip">请向店员出示此码</text></view></view></block></view>