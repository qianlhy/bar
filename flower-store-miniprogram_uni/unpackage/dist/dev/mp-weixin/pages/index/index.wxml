<view class="home-page"><view class="status-bar" style="{{('height:'+statusBarHeight+'px')}}"></view><view data-event-opts="{{[['tap',[['showStorePicker',['$event']]]]]}}" class="store-selector" bindtap="__e"><text class="store-name">{{storeName}}</text><text class="store-arrow">▶</text></view><scroll-view class="home-scroll" scroll-y="{{true}}"><view class="brand-section"><view class="brand-glow"></view><view class="brand-orb brand-orb-a"></view><view class="brand-orb brand-orb-b"></view><view class="logo-ring"><image class="brand-logo" src="/static/allIn.jpg" mode="aspectFill"></image></view><text class="brand-title">梭哈酒馆</text><view class="brand-sub-line"><view class="sub-line sub-line-left"></view><text class="texas-bar">All In Tavern</text><view class="sub-line sub-line-right"></view></view><text class="brand-motto">夜色入场 · 点单即达</text></view><view data-event-opts="{{[['tap',[['showMemberCode',['$event']]]]]}}" class="vip-card g-tap" bindtap="__e"><view class="vip-shine"></view><view class="vip-left"><view class="vip-avatar-wrap"><image class="vip-avatar" src="{{userInfo.avatar||'/static/allIn.jpg'}}" mode="aspectFill"></image></view><view class="vip-copy"><text class="vip-hello">{{userInfo.nickname||userInfo.nickName||'尊贵会员'}}</text><text class="vip-sub">点击出示会员码 · 到店核验</text></view></view><view class="vip-badge"><text class="vip-badge-text">MEMBER</text><text class="vip-badge-code">码</text></view></view><view data-event-opts="{{[['tap',[['goOrder',['$event']]]]]}}" class="hero-order g-tap" bindtap="__e"><view class="hero-order-bg">ORDER</view><view class="hero-order-main"><view class="hero-order-icon">点</view><view class="hero-order-copy"><text class="hero-order-title">立即点单</text><text class="hero-order-desc">精选酒水套餐 · 桌边即点即达</text></view></view><view class="hero-order-go">GO</view></view><view data-event-opts="{{[['tap',[['goRecharge',['$event']]]]]}}" class="recharge-row g-tap" bindtap="__e"><view class="recharge-icon">充</view><view class="recharge-copy"><text class="recharge-title">会员充值</text><text class="recharge-sub">{{"当前 All In 币 "+(userInfo.coins||0)+" · 充值享赠送"}}</text></view><text class="recharge-arrow">›</text></view><view data-event-opts="{{[['tap',[['showWifi',['$event']]]]]}}" class="wifi-row g-tap" bindtap="__e"><view class="wifi-icon">Wi</view><view class="wifi-copy"><text class="wifi-title">查看门店 WIFI</text><text class="wifi-sub">一键获取网络名称与密码</text></view><text class="wifi-arrow">›</text></view><view class="location-bar"><text class="diamond">◆</text><text class="location-text">{{storeAddress}}</text><text class="diamond">◆</text></view><view class="footer"><text class="footer-text">熠火提供技术支持</text></view></scroll-view><block wx:if="{{showPrivacy}}"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="privacy-mask" catchtap="__e"><view class="privacy-modal"><text class="privacy-title">用户隐私保护提示</text><scroll-view class="privacy-content" scroll-y="{{true}}"><text>{{"欢迎使用梭哈酒馆小程序。请在授权前阅读微信官方"+privacyContractName+"，了解头像、昵称以及订单和支付必要信息的处理方式。"}}</text><text class="privacy-p">您可以拒绝非必要授权并继续浏览商品；登录、下单或资料设置等功能只会在实际需要时申请对应信息。</text><text data-event-opts="{{[['tap',[['openPrivacyContract',['$event']]]]]}}" class="privacy-link" bindtap="__e">{{"查看微信官方"+privacyContractName}}</text></scroll-view><view class="privacy-btns"><view data-event-opts="{{[['tap',[['declinePrivacy',['$event']]]]]}}" class="privacy-btn decline" bindtap="__e">暂不授权</view><button class="privacy-btn agree" open-type="agreePrivacyAuthorization" data-event-opts="{{[['agreeprivacyauthorization',[['onAgreePrivacyAuthorization',['$event']]]]]}}" bindagreeprivacyauthorization="__e">同意并继续</button></view></view></view></block><block wx:if="{{showMemberModal}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="member-mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="member-modal" catchtap="__e"><text class="member-modal-title">会员码</text><block wx:if="{{memberCodeUrl}}"><image class="qrcode-img" src="{{memberCodeUrl}}" mode="aspectFit"></image></block><block wx:else><view class="qrcode-placeholder"><text class="qrcode-text">请先登录</text></view></block><text class="member-modal-tip">请向店员出示此码</text></view></view></block></view>