<view class="page-wrap"><block wx:if="{{!isLoading&&product}}"><view class="detail-page"><view class="swiper-wrap"><swiper class="product-swiper" indicator-dots="{{$root.g0>1}}" indicator-color="rgba(255,255,255,0.25)" indicator-active-color="#e8c547" autoplay="{{false}}" circular="{{true}}" data-event-opts="{{[['change',[['onSwiperChange',['$event']]]]]}}" bindchange="__e"><block wx:for="{{product.images}}" wx:for-item="img" wx:for-index="index" wx:key="index"><swiper-item><image class="swiper-img" src="{{img||'/static/allIn.jpg'}}" mode="aspectFit" data-event-opts="{{[['error',[['onImageError',[index]]]]]}}" binderror="__e"></image></swiper-item></block></swiper><block wx:if="{{$root.g1>1}}"><view class="swiper-index">{{current+1+"/"+$root.g2}}</view></block></view><view class="info-card"><view class="info-top"><view class="info-left"><text class="product-title">{{product.name}}</text><view class="meta-row"><text class="meta-tag">{{"销量 "+(product.sales||0)}}</text><text class="meta-tag">{{"库存 "+(product.inventory||0)}}</text></view><text class="product-desc">{{product.description||'精选酒吧套餐'}}</text></view><view data-event-opts="{{[['tap',[['quickAdd',['$event']]]]]}}" class="{{['quick-add '+(isSoldOut?'disabled':'')]}}" bindtap="__e">{{isSoldOut?'售罄':'+'}}</view></view><view class="price-row"><text class="price-symbol">¥</text><text class="price-num">{{product.price}}</text><text class="price-unit">/份</text><block wx:if="{{product.originalPrice}}"><text class="price-original">{{"¥"+product.originalPrice}}</text></block></view></view><view class="detail-card"><view class="detail-head"><view class="detail-line"></view><text class="detail-title">商品详情</text><view class="detail-line"></view></view><view class="detail-content"><text>{{product.detail||product.description||'暂无详情介绍'}}</text></view></view><view class="footer-bar"><view class="footer-nav"><view data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="nav-item g-tap" bindtap="__e"><text class="nav-icon">首</text><text class="nav-text">首页</text></view><button class="nav-item share-btn g-tap" open-type="share"><text class="nav-icon">享</text><text class="nav-text">分享</text></button><view data-event-opts="{{[['tap',[['goCart',['$event']]]]]}}" class="nav-item g-tap" bindtap="__e"><text class="nav-icon">车</text><text class="nav-text">购物车</text><block wx:if="{{cartCount>0}}"><view class="cart-badge">{{cartCount}}</view></block></view></view><view class="footer-actions"><view data-event-opts="{{[['tap',[['addToCart',['$event']]]]]}}" class="{{['btn-add-cart '+(isSoldOut?'disabled':'')]}}" bindtap="__e">{{''+(isSoldOut?'暂时售罄':'加入购物车')+''}}</view><view data-event-opts="{{[['tap',[['buyNow',['$event']]]]]}}" class="{{['btn-buy '+(isSoldOut?'disabled':'')]}}" bindtap="__e">立即购买</view></view></view></view></block><block wx:if="{{isLoading}}"><view class="loading-page"><view class="loading-spinner"></view><text class="loading-text">加载中...</text></view></block><block wx:if="{{product}}"><spec-modal vue-id="778f76c8-1" visible="{{showSpecModal}}" product="{{product}}" data-event-opts="{{[['^close',[['e0']]],['^confirm',[['onSpecConfirm']]]]}}" data-com-type="wx" bind:close="__e" bind:confirm="__e" bind:__l="__l"></spec-modal></block></view>