
.search-container {
    min-height: 100vh;
    background-color: var(--bg-page);
}

/* 搜索框样式 */
.search-header {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
    background: rgba(16, 16, 18, 0.98);
    border-bottom: 1rpx solid var(--border-subtle);
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 10;
}
.search-input-box {
    flex: 1;
    height: 76rpx;
    background-color: var(--bg-elevated);
    border: 1rpx solid var(--border-subtle);
    border-radius: 38rpx;
    display: flex;
    align-items: center;
    padding: 0 24rpx;
    margin-right: 20rpx;
}
.search-icon {
    margin-right: 12rpx;
    color: var(--text-faint);
}
.search-input {
    flex: 1;
    height: 100%;
    font-size: 28rpx;
    color: var(--text-primary);
}
.clear-icon {
    padding: 10rpx;
    color: var(--text-faint);
}
.search-btn {
    width: 100rpx;
    height: 76rpx;
    line-height: 76rpx;
    text-align: center;
    font-size: 28rpx;
    font-weight: 600;
    color: var(--gold);
}

/* 搜索历史和热门搜索样式 */
.search-history {
    padding: 20rpx;
}
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}
.section-title {
    font-size: 28rpx;
    color: var(--text-primary);
    font-weight: 600;
}
.clear-history {
    padding: 10rpx;
    color: var(--text-faint);
}
.history-list,
.hot-list {
    display: flex;
    flex-wrap: wrap;
}
.history-item,
.hot-item {
    padding: 12rpx 26rpx;
    background-color: var(--bg-elevated);
    border: 1rpx solid var(--border-subtle);
    border-radius: 30rpx;
    margin: 0 20rpx 20rpx 0;
    font-size: 24rpx;
    color: var(--text-regular);
}
.hot-item {
    background-color: rgba(232, 197, 71, 0.08);
    border-color: rgba(232, 197, 71, 0.28);
    color: var(--gold-light);
}
.hot-section {
    margin-top: 30rpx;
}

/* 搜索结果样式 */
.search-results {
    padding: 20rpx;
}

/* 加载中样式 */
.loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}
.loading-icon {
    width: 80rpx;
    height: 80rpx;
    margin-bottom: 20rpx;
}
.loading text {
    font-size: 28rpx;
    color: var(--text-muted);
}

/* 空结果样式 */
.empty-result {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}
.empty-icon {
    width: 150rpx;
    height: 150rpx;
    margin-bottom: 30rpx;
}
.empty-tip {
    font-size: 30rpx;
    color: var(--text-regular);
    margin-bottom: 10rpx;
}
.suggestion {
    font-size: 26rpx;
    color: var(--text-faint);
}

/* 结果列表样式 */
.result-list {
    padding-bottom: 30rpx;
}
.result-item {
    display: flex;
    padding: 22rpx;
    background: var(--bg-card-gradient);
    border: 1rpx solid var(--border-subtle);
    border-radius: 20rpx;
    margin-bottom: 20rpx;
    position: relative;
    box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.22);
}
.product-image {
    width: 180rpx;
    height: 180rpx;
    border-radius: 14rpx;
    background-color: var(--bg-sunken);
    margin-right: 22rpx;
    flex-shrink: 0;
}
.product-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.product-name {
    font-size: 28rpx;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 10rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}
.product-desc {
    font-size: 24rpx;
    color: var(--text-faint);
    line-height: 1.4;
    margin-bottom: 10rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
}
.product-price-box {
    display: flex;
    align-items: baseline;
    margin-bottom: 10rpx;
}
.price {
    color: var(--gold);
    font-weight: 700;
    font-size: 32rpx;
}
.price-original {
    color: var(--text-faint);
    text-decoration: line-through;
    font-size: 24rpx;
    margin-left: 10rpx;
}
.product-sales {
    font-size: 22rpx;
    color: var(--text-faint);
}
.add-cart-btn {
    position: absolute;
    right: 22rpx;
    bottom: 22rpx;
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: #171717;
    font-size: 40rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 20rpx rgba(232, 197, 71, 0.24);
}

