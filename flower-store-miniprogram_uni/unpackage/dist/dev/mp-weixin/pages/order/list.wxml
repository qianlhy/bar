<view class="order-list-container"><view class="tabs"><block wx:for="{{tabs}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['tab-item '+(activeTab===item.id?'active':'')]}}" data-id="{{item.id}}" data-event-opts="{{[['tap',[['switchTab',['$event']]]]]}}" bindtap="__e"><text>{{item.name}}</text><block wx:if="{{activeTab===item.id}}"><view class="tab-line"></view></block></view></block></view><scroll-view class="order-scroll" scroll-y="{{true}}" enable-back-to-top="{{true}}"><block wx:if="{{isLoading}}"><view class="loading-container"><view class="loading-dot"></view><text class="loading-text">加载中...</text></view></block><block wx:if="{{!isLoading&&isEmpty}}"><view class="empty-state"><text class="empty-state-icon">暂无</text><text class="empty-state-text">暂无订单</text><text class="empty-state-tip">去点一杯，开启今晚的局</text></view></block><block wx:for="{{$root.l1}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="order-item"><view class="order-header" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['goToOrderDetail',['$event']]]]]}}" bindtap="__e"><view class="order-number">{{"订单号 "+(item.$orig.orderNo||item.$orig.id)}}</view><view class="{{['order-status '+item.m0]}}">{{item.$orig.statusText}}</view></view><view class="order-goods" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['goToOrderDetail',['$event']]]]]}}" bindtap="__e"><block wx:for="{{item.l0}}" wx:for-item="goods" wx:for-index="index1" wx:key="index1"><view class="goods-item"><image class="goods-image" src="{{goods.$orig.productImage||'/static/allIn.jpg'}}" mode="aspectFill"></image><view class="goods-info"><view class="goods-name text-ellipsis">{{goods.$orig.productName}}</view><view class="goods-price">{{"¥"+goods.m1+" × "+goods.$orig.count}}</view></view></view></block></view><view class="order-footer"><view class="order-total"><text class="total-count">{{"共 "+item.g0+" 件"}}</text><view class="total-amount"><text class="total-label">合计</text><text class="total-price">{{"¥"+item.m2}}</text></view></view><view class="order-actions"><block wx:if="{{item.$orig.statusText==='待付款'}}"><block><view class="action-btn outline" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['cancelOrder',['$event']]]]]}}" bindtap="__e">取消订单</view><view class="action-btn primary" data-id="{{item.$orig.id}}" data-amount="{{item.$orig.actualPayment}}" data-event-opts="{{[['tap',[['goToPay',['$event']]]]]}}" bindtap="__e">去支付</view></block></block><block wx:else><block><view class="action-btn outline" data-id="{{item.$orig.id}}" data-event-opts="{{[['tap',[['goToOrderDetail',['$event']]]]]}}" bindtap="__e">订单详情</view></block></block></view></view></view></block><view class="scroll-bottom-space"></view></scroll-view></view>