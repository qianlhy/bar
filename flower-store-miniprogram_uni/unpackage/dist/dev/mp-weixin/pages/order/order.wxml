<view class="order-container"><view class="table-section"><view class="section-title">就餐信息</view><view class="table-info"><text class="table-label">桌台号</text><input class="table-input" placeholder="请输入桌台号（选填）" data-event-opts="{{[['input',[['inputTableNo',['$event']]]]]}}" value="{{tableNo}}" bindinput="__e"/></view><view class="store-tag-row"><view class="store-copy"><text class="store-name">梭哈酒馆 · 南京店</text><text class="store-address">南京市浦口区江浦街道</text></view><view class="instore-tag">店内</view></view></view><view class="goods-section"><view class="section-title">商品清单</view><view class="goods-list"><block wx:for="{{orderItems}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="goods-item"><image class="goods-image" src="{{item.image||'/static/allIn.jpg'}}" mode="aspectFill" data-event-opts="{{[['error',[['onGoodsImageError',[index]]]]]}}" binderror="__e"></image><view class="goods-info"><text class="goods-name text-ellipsis">{{item.name}}</text><block wx:if="{{item.specText}}"><text class="goods-spec">{{item.specText}}</text></block><view class="goods-price-box"><text class="price">{{"¥"+item.price}}</text><text class="count">{{"x"+item.count}}</text></view></view></view></block></view></view><view class="payment-section"><view class="section-title">支付方式</view><view class="payment-options"><view class="{{['payment-option '+(paymentMethod==='online'?'selected':'')]}}" data-method="online" data-event-opts="{{[['tap',[['switchPaymentMethod',['$event']]]]]}}" bindtap="__e"><view class="payment-icon wechat-pay">微</view><view class="payment-copy"><text class="payment-name">微信支付</text><text class="payment-desc">安全快捷支付</text></view><view class="radio-box"><view class="{{['radio '+(paymentMethod==='online'?'selected':'')]}}"></view></view></view></view></view><block wx:if="{{pointsEnabled}}"><view class="points-section"><view class="section-title">积分抵扣</view><view data-event-opts="{{[['tap',[['toggleUsePoints',['$event']]]]]}}" class="points-row" bindtap="__e"><view class="points-left"><text class="points-label">使用积分</text><text class="points-desc">{{"可用 "+availablePoints+" 分 · 100分抵1元 · 最多抵50%"}}</text></view><view class="{{['points-switch '+(usePointsToggle?'on':'')]}}"><view class="points-switch-dot"></view></view></view><block wx:if="{{usePointsToggle}}"><view class="points-row"><text class="points-label">抵扣</text><text class="points-value">{{"-"+usePoints+"分 / ¥"+pointsDiscount}}</text></view></block></view></block><view class="remark-section"><view class="section-title">订单备注</view><textarea class="remark-input" placeholder="请输入订单备注（选填）" maxlength="100" data-event-opts="{{[['input',[['inputRemark',['$event']]]]]}}" value="{{remark}}" bindinput="__e"></textarea></view><view class="amount-section"><view class="amount-item"><text class="amount-label">商品金额</text><text class="amount-value">{{"¥"+$root.m0}}</text></view><view class="amount-item"><text class="amount-label">服务费</text><text class="amount-value">¥0.00</text></view><block wx:if="{{usePointsToggle&&pointsDiscount>0}}"><view class="amount-item"><text class="amount-label">积分抵扣</text><text class="amount-value discount">{{"-¥"+$root.m1}}</text></view></block><view class="divider"></view><view class="amount-item total"><text class="amount-label">实付款</text><text class="amount-value price">{{"¥"+$root.m2}}</text></view></view><view class="footer"><view class="total-info"><text class="total-label">合计：</text><text class="total-price">{{"¥"+$root.m3}}</text></view><button class="{{['submit-btn '+(isLoading?'loading':'')]}}" disabled="{{isLoading}}" data-event-opts="{{[['tap',[['submitOrder',['$event']]]]]}}" bindtap="__e">{{''+(isLoading?'提交中...':'提交订单')+''}}</button></view></view>