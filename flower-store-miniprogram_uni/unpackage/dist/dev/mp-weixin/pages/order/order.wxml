<view class="order-container"><view class="table-section"><view class="section-title">就餐信息</view><view class="table-info"><text class="table-label">桌台号</text><input class="table-input" placeholder="请输入桌台号（选填）" data-event-opts="{{[['input',[['inputTableNo',['$event']]]]]}}" value="{{tableNo}}" bindinput="__e"/></view><view class="store-tag-row"><text class="store-name">27 POKER BAR-武昌店</text><view class="instore-tag">店内</view></view></view><view class="goods-section"><view class="section-title">商品清单</view><view class="goods-list"><block wx:for="{{orderItems}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="goods-item"><image class="goods-image" src="{{item.image}}" mode="aspectFill"></image><view class="goods-info"><text class="goods-name text-ellipsis">{{item.name}}</text><view class="goods-price-box"><text class="price">{{"¥"+item.price}}</text><text class="count">{{"x"+item.count}}</text></view></view></view></block></view></view><view class="payment-section"><view class="section-title">支付方式</view><view class="payment-options"><view class="{{['payment-option '+(paymentMethod==='online'?'selected':'')]}}" data-method="online" data-event-opts="{{[['tap',[['switchPaymentMethod',['$event']]]]]}}" bindtap="__e"><text class="payment-icon-text">💳</text><text class="payment-name">微信支付</text><view class="radio-box"><view class="{{['radio '+(paymentMethod==='online'?'selected':'')]}}"></view></view></view><view class="{{['payment-option '+(paymentMethod==='balance'?'selected':'')]}}" data-method="balance" data-event-opts="{{[['tap',[['switchPaymentMethod',['$event']]]]]}}" bindtap="__e"><text class="payment-icon-text">💰</text><text class="payment-name">余额支付</text><view class="radio-box"><view class="{{['radio '+(paymentMethod==='balance'?'selected':'')]}}"></view></view></view></view></view><view class="remark-section"><view class="section-title">订单备注</view><textarea class="remark-input" placeholder="请输入订单备注（选填）" maxlength="100" data-event-opts="{{[['input',[['inputRemark',['$event']]]]]}}" value="{{remark}}" bindinput="__e"></textarea></view><view class="amount-section"><view class="amount-item"><text class="amount-label">商品金额</text><text class="amount-value">{{"¥"+totalPrice}}</text></view><view class="amount-item"><text class="amount-label">服务费</text><text class="amount-value">¥0.00</text></view><view class="divider"></view><view class="amount-item total"><text class="amount-label">实付款</text><text class="amount-value price">{{"¥"+actualPayment}}</text></view></view><view class="footer"><view class="total-info"><text class="total-label">合计：</text><text class="total-price">{{"¥"+actualPayment}}</text></view><button class="{{['submit-btn '+(isLoading?'loading':'')]}}" disabled="{{isLoading}}" data-event-opts="{{[['tap',[['submitOrder',['$event']]]]]}}" bindtap="__e">{{''+(isLoading?'提交中...':'提交订单')+''}}</button></view></view>