<view class="order-detail-container"><view class="{{['status-section status-'+statusTone]}}"><text class="status-text">{{statusText||'订单详情'}}</text><text class="status-desc">{{statusDesc}}</text></view><view class="card"><view class="section-head">就餐信息</view><view class="store-row"><view class="store-copy"><text class="store-name">梭哈酒馆 · 南京店</text><text class="store-address">南京市浦口区江浦街道</text></view><view class="instore-tag">{{tableNoText}}</view></view></view><view class="card"><view class="section-head">商品清单</view><view class="goods-list"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="goods-item"><image class="goods-image" src="{{item.$orig.productImage||'/static/allIn.jpg'}}" mode="aspectFill"></image><view class="goods-info"><view class="goods-name">{{item.$orig.productName}}</view><block wx:if="{{item.$orig.specText}}"><view class="goods-spec">{{item.$orig.specText}}</view></block><view class="goods-price-count"><text class="goods-price">{{"¥"+item.m0}}</text><text class="goods-count">{{"x"+item.$orig.count}}</text></view></view></view></block></view></view><view class="card"><view class="section-head">订单信息</view><view class="order-info-item"><text class="label">订单编号</text><view class="value-copy"><text class="value">{{order.orderNo||orderId}}</text><view data-event-opts="{{[['tap',[['copyOrderId',['$event']]]]]}}" class="copy-btn" bindtap="__e">复制</view></view></view><view class="order-info-item"><text class="label">下单时间</text><text class="value">{{order.createTime}}</text></view><view class="order-info-item"><text class="label">支付方式</text><text class="value">微信支付</text></view><block wx:if="{{order.remark}}"><view class="order-info-item"><text class="label">订单备注</text><text class="value">{{order.remark}}</text></view></block></view><view class="card"><view class="amount-item"><text class="label">商品金额</text><text class="value">{{"¥"+$root.m1}}</text></view><view class="amount-item"><text class="label">服务费</text><text class="value">¥0.00</text></view><block wx:if="{{order.pointsUsed>0}}"><view class="amount-item"><text class="label">积分抵扣</text><text class="value discount">{{"-¥"+$root.m2+"（"+order.pointsUsed+"分）"}}</text></view></block><view class="divider"></view><view class="amount-item total"><text class="label">实付款</text><text class="value">{{"¥"+$root.m3}}</text></view></view><block wx:if="{{statusText==='待付款'}}"><view class="footer"><button data-event-opts="{{[['tap',[['cancelOrder',['$event']]]]]}}" class="btn" bindtap="__e">取消订单</button><button data-event-opts="{{[['tap',[['goToPay',['$event']]]]]}}" class="btn primary" bindtap="__e">去支付</button></view></block></view>