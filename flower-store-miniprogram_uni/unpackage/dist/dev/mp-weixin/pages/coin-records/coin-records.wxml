<view class="records-page"><scroll-view class="records-scroll" scroll-y="{{true}}"><block wx:for="{{records}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="record-item"><view class="record-left"><text class="record-name">{{item.productName}}</text><text class="record-time">{{item.createTime}}</text></view><text class="record-coin">{{"-"+item.coinPrice+" 币"}}</text></view></block><block wx:if="{{$root.g0}}"><view class="empty"><text>暂无兑换记录</text></view></block></scroll-view></view>