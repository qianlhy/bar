<view class="user-page poker-bg"><view class="user-header"><image class="user-avatar" src="{{userInfo.avatar||'/static/allIn.jpg'}}" mode="aspectFill"></image><block wx:if="{{isLogin}}"><view class="user-text"><text class="user-greet font-art">{{userInfo.nickname||'欢迎加入'}}</text><text class="user-sub">注册后解锁更多会员特权</text></view></block><block wx:else><view class="user-text"><text class="user-greet font-art">欢迎加入</text><text class="user-sub">注册后解锁更多会员特权</text></view></block><block wx:if="{{!isLogin}}"><view data-event-opts="{{[['tap',[['goToLogin',['$event']]]]]}}" class="register-btn g-tap" bindtap="__e">注册会员</view></block><block wx:else><view data-event-opts="{{[['tap',[['goSettings',['$event']]]]]}}" class="register-btn g-tap" bindtap="__e">个人中心</view></block></view><view class="asset-card mesh-card"><view data-event-opts="{{[['tap',[['goRecharge',['$event']]]]]}}" class="asset-item g-tap" bindtap="__e"><text class="asset-label">All In 币</text><text class="asset-value g-num font-art neon-cyan">{{userInfo.coins||0}}</text></view><view class="asset-divider"></view><view class="asset-item"><text class="asset-label">积分</text><text class="asset-value g-num font-art neon-gold">{{userInfo.points||0}}</text></view></view><view class="func-card mesh-card"><text class="func-title font-art">常用功能</text><view class="func-grid"><view data-event-opts="{{[['tap',[['goSettings',['$event']]]]]}}" class="func-item g-tap" bindtap="__e"><view class="icon-box"><view class="line-icon icon-user"></view></view><text class="func-name">个人中心</text></view><view data-event-opts="{{[['tap',[['goOrders',['$event']]]]]}}" class="func-item g-tap" bindtap="__e"><view class="icon-box"><view class="line-icon icon-order"></view></view><text class="func-name">订单中心</text></view><view data-event-opts="{{[['tap',[['goCoinMall',['$event']]]]]}}" class="func-item g-tap" bindtap="__e"><view class="icon-box"><view class="line-icon icon-coin"></view></view><text class="func-name">币商城</text></view><view data-event-opts="{{[['tap',[['goRecharge',['$event']]]]]}}" class="func-item g-tap" bindtap="__e"><view class="icon-box"><view class="line-icon icon-recharge"></view></view><text class="func-name">会员充值</text></view><view data-event-opts="{{[['tap',[['goRank',['$event']]]]]}}" class="func-item g-tap" bindtap="__e"><view class="icon-box"><view class="line-icon icon-rank"></view></view><text class="func-name">大师分</text></view></view></view><view class="store-card mesh-card"><view class="store-top"><image class="store-logo" src="/static/allIn.jpg" mode="aspectFit"></image><text class="store-name font-art">梭哈酒馆</text></view><view class="store-msg"><text>HI~ 欢迎光临本店</text><text>如需帮助，请到店咨询工作人员。</text></view></view><block wx:if="{{isLogin}}"><view data-event-opts="{{[['tap',[['logout',['$event']]]]]}}" class="logout-btn g-tap" bindtap="__e">退出登录</view></block><view class="footer"><text class="footer-text">熠火提供技术支持</text></view></view>